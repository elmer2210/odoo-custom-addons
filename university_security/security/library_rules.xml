<odoo>
    <!-- Regla: Solo el bibliotecario autorizado puede aprobar donaciones -->
    <record id="rule_librarian_donation_approval" model="ir.rule">
        <field name="name">Solo Bibliotecario Autorizado Puede Aprobar</field>
        <field name="model_id" ref="library_management.model_library_donation"/>
        <field name="groups" eval="[(4, ref('university_security.group_librarian'))]"/>
        <field name="domain_force">[
            '|',
            ('state', '!=', 'pending'),
            ('create_uid.is_donation_approver', '=', True)
        ]</field>
    </record>
     <!-- Regla: Los bibliotecarios pueden ver los registros, pero no modificarlos -->
    <record id="rule_librarian_student_entry" model="ir.rule">
        <field name="name">Bibliotecarios Solo Pueden Ver</field>
        <field name="model_id" ref="student_management.model_student_entry"/>
        <field name="groups" eval="[(4, ref('university_security.group_librarian'))]"/>
        <field name="domain_force">[
            ('create_uid', '=', user.id)
        ]</field>
    </record>
</odoo>
