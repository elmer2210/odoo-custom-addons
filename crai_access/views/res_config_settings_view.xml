<odoo>
  <record id="res_config_settings_view_form_crai_reading" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.crai.reading</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <!-- Inserta dentro del contenedor principal de ajustes -->
      <xpath expr="//div[@id='crai_students_settings']" position='after'>
        <div class="app_settings_block" string="Acceso Sala Lectura" name="crai_reading_access_block">
            <block title="Acceso Sala Lectura" name="reading_setting_container">
                <setting id="default_source_setting">
                    <field name="ra_default_source"/>
                    <label for="ra_default_source"/>
                    <div class="text-muted">
                        Fuente por defecto para registros creados (kiosk/manual).
                    </div>
                </setting>
                <setting id="duplicate_setting">
                    <field name="ra_duplicate_window_seconds"/>
                    <label for="ra_duplicate_window_seconds"/>
                    <div class="text-muted">
                        Ventana anti-duplicado (segundos) para evitar doble escaneo.
                    </div>
                </setting>
            </block>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
