<?xml version="1.0" encoding="UTF-8"?>
<odoo>
       <!-- Acción para Registrar Ingresos -->
    <record id="action_student_entry_form" model="ir.actions.act_window">
        <field name="name">Registros Ingresos Sala Lectura</field>
        <field name="res_model">library.entry</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_student_entry_form"/>
        <field name="target">fullscreen</field>
    </record>
     <record id="action_student_computer" model="ir.actions.act_window">
        <field name="name">Registros Uso Equipos Cómputos</field>
        <field name="res_model">library.computer</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_student_computer_tree"/>
    </record>
     <!-- Acción para Historial de Ingresos -->
    <record id="action_student_entry" model="ir.actions.act_window">
        <field name="name">Historial de Ingresos Sala Lectura</field>
        <field name="res_model">library.entry</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_student_entry_tree"/>
    </record>

       <!-- Acción para Cubículos -->
    <record id="action_library_cubicle" model="ir.actions.act_window">
        <field name="name">Gestión de Cubículos</field>
        <field name="res_model">library.cubicle</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <!-- Acción para Préstamos -->
    <record id="action_library_loan" model="ir.actions.act_window">
        <field name="name">Préstamos de Cubículos</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">kanban,tree,form,graph</field>
         <field name="context">{'default_state': 'active'}</field>
    </record>

     <!-- Acción para Ver el Calendario de Reservas -->
    <record id="action_library_reservation_calendar" model="ir.actions.act_window">
        <field name="name">Calendario de Reservas</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_library_reservation_calendar"/>
        <field name="context">{'default_state': 'reserved'}</field>
    </record>

      <!-- Action de donaciones de libros -->
    <record id="action_library_donation" model="ir.actions.act_window">
        <field name="name">Gestión de donaciones</field>
        <field name="res_model">library.donation</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
