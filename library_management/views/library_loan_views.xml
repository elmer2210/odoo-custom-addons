<odoo>

    <!--Vista Form-->
    <record id="view_library_loan_tree" model="ir.ui.view">
        <field name="name">library.loan.tree</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="cubicle_id"/>
                <field name="student_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!--Vista Kanban-->
    <record id="view_library_loan_kanban" model="ir.ui.view">
        <field name="name">library.loan.kanban</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="display_name"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="state"/>
                <field name="cubicle_id"/>
                <templates>
                    <t t-name="kanban-box">
                       <div class="oe_kanban_global_click card shadow-sm p-3 mb-3" style="border-radius: 10px;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-primary">
                                    <t t-esc="record.display_name.value"/>
                                </strong>
                                <span class="badge badge-pill"
                                    t-att-class="'badge-' + (record.state.raw_value == 'active' and 'success' or record.state.raw_value == 'reserved' and 'warning' or 'secondary')">
                                    <t t-esc="record.state.value"/>
                                </span>
                            </div>

                            <div class="text-muted small">
                                <i class="fa fa-calendar"></i> <strong>Inicio:</strong> <t t-esc="record.start_time.value"/>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-calendar"></i> <strong>Fin:</strong> <t t-esc="record.end_time.value"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!--Vista Tree-->
    <record id="view_library_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Campo de estado como statusbar -->
                    <field name="state" widget="statusbar" statusbar_visible="active,returned,reserved,overdue" options="{'clickable': 1}"/>
                </header>
                <sheet>
                    <group>
                         <!-- Campo para escanear el código de barras -->
                        <field name="cubicle_id" required="1" />
                        <field name="barcode" string="Código de Barras del Estudiante" 
                            placeholder="Escanea el código aquí" widget="barcode"  
                            options="{'no_create': True}" autofocus="autofocus"/>
                        <field name="student_id" invisible="1"/>
                        <field name="student_name" readonly="1"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Vista Graph-->
    <record id="view_library_loan_graph" model="ir.ui.view">
        <field name="name">library.loan.graph</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <graph string="Préstamos por Estado" type="bar">
                <field name="state" type="row"/>  <!-- Agrupar por estado -->
                <field name="start_time" type="row" interval="day"/>
                <field name="id" type="measure" operator="count" string="Cantidad de Préstamos"/>  <!-- Contar registros -->
                <field name="date" type="colspan" string="Fecha del Préstamo"/>
            </graph>
        </field>
    </record>

     <!--Vista Seach con fitro-->
    <record id="view_library_loan_search" model="ir.ui.view">
        <field name="name">library.loan.search</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <search string="Buscar Préstamos de Cubículos">
                <filter name="filter_active_today" string="Activos Hoy" 
                        domain="[('state', '=', 'active')]"
                        help="Muestra solo préstamos activos de hoy" />
                <field name="state"/>
                <field name="start_time"/>
                <field name="end_time"/>
            </search>
        </field>
    </record>

</odoo>
