<odoo>
    <data noupdate="0">
        <record id="email_template_donation_approval" model="mail.template">
            <field name="name">Notificación de Donación para Aprobación</field>
            <field name="model_id" ref="library_donations.model_library_donation"/>
            <field name="subject">Nueva Donación ${object.name}</field>
            <field name="email_from">${(user.email or 'info@umet.edu.ec')|safe}</field>
            <field name="email_to">${(object.get_donation_approver_email() or 'info@umet.edu.ec')|safe}</field>
            <field name="body_html">
                <![CDATA[
                <p>Estimada MSc. Jacqueline Baque</p>
                <p>Se ha registrado una nueva donación que requiere tu aprobación:</p>
                <ul>
                    <li><strong>Código:</strong> ${object.name}</li>
                    <li><strong>Tipo:</strong> ${object.donation_type}</li>
                    <li><strong>Fecha:</strong> ${object.date}</li>
                    <li><strong>Carrera:</strong> ${object.career_id.name}</li>
                    <li><strong>Total:</strong> ${object.total_cost}</li>
                </ul>
                <p>Por favor, revisa y aprueba la donación en el sistema.</p>
                <p>Gracias.</p>
                ]]>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>