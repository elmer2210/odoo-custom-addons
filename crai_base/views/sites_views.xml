<odoo>
  <record id="view_crai_sede_tree" model="ir.ui.view">
    <field name="name">crai.site.tree</field>
    <field name="model">crai.site</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="code"/>
        <field name="secretary_email"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="view_crai_sede_form" model="ir.ui.view">
    <field name="name">crai.site.form</field>
    <field name="model">crai.site</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="active"/>
          </group>
          <group string="Notificaciones">
            <field name="secretary_email" widget="email"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_crai_site" model="ir.actions.act_window">
    <field name="name">Sedes</field>
    <field name="res_model">crai.site</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_crai_site" name="Sedes" parent="menu_crai_config"
            action="action_crai_site" sequence="10"/>
</odoo>
