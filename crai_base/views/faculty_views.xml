<odoo>
  <record id="view_crai_faculty_tree" model="ir.ui.view">
    <field name="name">crai.faculty.tree</field>
    <field name="model">crai.faculty</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="code"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="view_crai_faculty_form" model="ir.ui.view">
    <field name="name">crai.faculty.form</field>
    <field name="model">crai.faculty</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_crai_faculty" model="ir.actions.act_window">
    <field name="name">Facultades</field>
    <field name="res_model">crai.faculty</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_crai_faculty" name="Facultades" parent="menu_crai_config"
            action="action_crai_faculty" sequence="30"/>
</odoo>
