<odoo>
  <record id="view_crai_campus_tree" model="ir.ui.view">
    <field name="name">crai.campus.tree</field>
    <field name="model">crai.campus</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="code"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="view_crai_campus_form" model="ir.ui.view">
    <field name="name">crai.campus.form</field>
    <field name="model">crai.campus</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_crai_campus" model="ir.actions.act_window">
    <field name="name">Sedes</field>
    <field name="res_model">crai.campus</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_crai_campus" name="Sedes" parent="menu_crai_config"
            action="action_crai_campus" sequence="10"/>
</odoo>
