<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== TREE VIEW ==================== -->
    <record id="view_crai_donation_tree" model="ir.ui.view">
        <field name="name">crai.donation.tree</field>
        <field name="model">crai.donation</field>
        <field name="arch" type="xml">
            <tree string="Donaciones" 
                  decoration-info="state == 'draft'" 
                  decoration-primary="state == 'submitted'"
                  decoration-success="state in ('approved', 'certificate_issued')"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="donation_type"/>
                <field name="student_id" optional="show"/>
                <field name="external_donor_name" optional="show"/>
                <field name="campus_id"/>
                <field name="book_count"/>
                <field name="total_cost" sum="Total" widget="monetary"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'submitted'"
                       decoration-success="state in ('approved', 'certificate_issued')"
                       decoration-danger="state == 'rejected'"/>
                <field name="submission_date" optional="hide"/>
                <field name="librarian_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_crai_donation_form" model="ir.ui.view">
        <field name="name">crai.donation.form</field>
        <field name="model">crai.donation</field>
        <field name="arch" type="xml">
            <form string="Donación de Libros">
                <header>
                    <!-- Botones según estado -->
                    <button name="action_submit" type="object" string="Enviar para Aprobación"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            confirm="¿Está seguro de enviar esta solicitud? Una vez enviada no podrá modificarla."/>
                    
                    <button name="action_approve" type="object" string="Aprobar Donación"
                            class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="crai_base.group_crai_donation_approver"/>
                    
                    <button name="action_reject" type="object" string="Rechazar"
                            invisible="state != 'submitted'"
                            groups="crai_base.group_crai_donation_approver"/>
                    
                    <button name="action_generate_certificate" type="object" string="Generar Certificado"
                            class="oe_highlight"
                            invisible="state != 'approved' or certificate_number"
                            groups="crai_base.group_crai_admin,crai_base.group_crai_donation_approver"/>
                    
                    <button name="action_print_certificate" type="object" string="Imprimir Certificado"
                            invisible="not certificate_number"/>
                    
                    <button name="action_set_to_draft" type="object" string="Volver a Borrador"
                            invisible="state not in ('rejected', 'submitted')"
                            groups="crai_base.group_crai_admin"/>
                    
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,submitted,approved,certificate_issued"/>
                </header>
                
                <sheet>
                    <!-- Banner para certificado emitido -->
                    <div class="alert alert-success text-center" role="alert" 
                         invisible="not certificate_number">
                        <strong>Certificado Emitido:</strong> <field name="certificate_number" readonly="1"/>
                        <br/>
                        <strong>Código de Verificación:</strong> <field name="certificate_code" readonly="1"/>
                    </div>
                    
                    <!-- Banner para rechazado -->
                    <div class="alert alert-danger" role="alert" 
                         invisible="state != 'rejected'">
                        <strong>Donación Rechazada</strong>
                        <p><field name="rejection_reason" readonly="1"/></p>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="main_info">
                            <field name="donation_type" readonly="state != 'draft'"/>
                            <field name="campus_id" readonly="state != 'draft'"/>
                            <field name="librarian_id" readonly="1"/>
                        </group>
                        <group name="dates_info">
                            <field name="submission_date" readonly="1"/>
                            <field name="approval_date" readonly="1" invisible="not approval_date"/>
                            <field name="approver_id" readonly="1" invisible="not approver_id"/>
                            <field name="certificate_issued_date" readonly="1" 
                                   invisible="not certificate_issued_date"/>
                        </group>
                    </group>
                    
                    <!-- INFORMACIÓN DEL DONANTE -->
                    <notebook>
                        <page string="Información del Donante" name="donor_info">
                            <!-- Para estudiantes (individual o grupal) -->
                            <group invisible="donation_type == 'external'">
                                <group>
                                    <field name="student_id" 
                                           required="donation_type in ('individual', 'group')"
                                           readonly="state != 'draft'"
			        	   domain="[('campus_id', '=', campus_id)]"
                                           options="{'no_create': True}"/>
                                    <field name="student_career_id" readonly="1"/>
                                </group>
                            </group>
                            
                            <!-- Estudiantes adicionales para donación grupal -->
                            <group string="Estudiantes del Grupo" 
                                   invisible="donation_type != 'group'">
                                <field name="group_student_ids" 
                                       widget="many2many_tags"
                                       readonly="state != 'draft'"
                                       domain="[('campus_id', '=', campus_id), ('career_id', '=', student_career_id)]"
                                       options="{'no_create': True}"
                                       nolabel="1"
                                       colspan="2"
                                       placeholder="Seleccione a los estudiantes del grupo..." 
                                 />
                            </group>
                            
                            <!-- Para donantes externos -->
                            <group invisible="donation_type != 'external'">
                                <group>
                                    <field name="external_donor_name" 
                                           required="donation_type == 'external'"
                                           readonly="state != 'draft'"/>
                                    <field name="external_donor_email" 
                                           widget="email"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="external_donor_phone" 
                                           widget="phone"
                                           readonly="state != 'draft'"/>
                                    <field name="external_donor_organization" 
                                           readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- LIBROS DONADOS -->
                        <page string="Libros Donados" name="books">
                            <field name="book_ids" readonly="state != 'draft'">
    
                                <tree string="Libros Donados">
                                   <field name="title"/>
                                   <field name="author"/>
                                   <field name="isbn"/>
                                   <field name="quantity" sum="Total Libros"/>
                                   <field name="cost" string="Costo Unit."/>
                                   <field name="total_cost" sum="Costo Total"/>
                                   <field name="condition" string="Estado"/>
                               </tree>

                               <form string="Detalle del Libro">
                                   <sheet>
                                      <group>
                                          <group string="Información Principal">
                                              <field name="title" required="1"/>
                                              <field name="author"/>
                                              <field name="isbn"/>
                                          </group>
                                         <group string="Edición y Publicación">
                                              <field name="publisher"/>
                                              <field name="edition"/>
                                              <field name="publication_year" options="{'format': 0}"/>
                                         </group>
                                         <group string="Costos y Estado">
                                              <field name="quantity"/>
                                              <field name="cost"/>
                                              <field name="total_cost" readonly="1"/>
                                              <field name="condition"/>
                                         </group>
                                      </group>
                                   </sheet>
                                </form>
                             </field>
                        </page>
                        
                        <!-- FACTURA Y DOCUMENTOS -->
                        <page string="Factura y Documentos" 
                              name="invoice"
                              invisible="donation_type == 'external'">
                            <group>
                                <field name="invoice_file" 
                                       filename="invoice_filename"
                                       readonly="state not in ('draft', 'submitted')"/>
                                <field name="invoice_filename" invisible="1"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>Nota:</strong> La factura es obligatoria para donaciones de estudiantes.
                                Debe incluir los costos de los libros donados.
                            </div>
                        </page>
                        
                        <!-- OBSERVACIONES -->
                        <page string="Observaciones" name="notes">
                            <field name="notes" 
                                   placeholder="Ingrese cualquier observación o comentario adicional..."
                                   readonly="state not in ('draft', 'submitted')"/>
                        </page>
                    </notebook>
                </sheet>
                
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="view_crai_donation_search" model="ir.ui.view">
        <field name="name">crai.donation.search</field>
        <field name="model">crai.donation</field>
        <field name="arch" type="xml">
            <search string="Buscar Donaciones">
                <!-- Campos de búsqueda -->
                <field name="name"/>
                <field name="student_id"/>
                <field name="external_donor_name"/>
                <field name="donation_type"/>
                <field name="state"/>
                <field name="campus_id"/>
                
                <!-- Campo invisible requerido para el filtro -->
                <field name="user_id" invisible="1"/>
                
                <!-- Filtros por estado -->
                <filter string="Borrador" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmado" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Validado" name="validated" domain="[('state','=','validated')]"/>
                
                <!-- Filtro de campus -->
                <filter name="my_campus" 
                        string="Mi Campus"
                        domain="[('user_id', '=', uid)]"/>
                
                <!-- Separador -->
                <separator/>
                
                <!-- Agrupación -->
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo de Donación" name="group_type" context="{'group_by':'donation_type'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Campus" name="group_campus" context="{'group_by':'campus_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== KANBAN VIEW ==================== -->
    <record id="view_crai_donation_kanban" model="ir.ui.view">
        <field name="name">crai.donation.kanban</field>
        <field name="model">crai.donation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="donation_type"/>
                <field name="student_id"/>
                <field name="external_donor_name"/>
                <field name="campus_id"/>
                <field name="book_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span class="badge" t-att-class="record.state.raw_value == 'draft' ? 'bg-info' : record.state.raw_value == 'submitted' ? 'bg-primary' : record.state.raw_value == 'approved' ? 'bg-success' : record.state.raw_value == 'rejected' ? 'bg-danger' : 'bg-secondary'">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="donation_type"/>
                                <br/>
                                <t t-if="record.student_id.raw_value">
                                    <i class="fa fa-user"/> <field name="student_id"/>
                                </t>
                                <t t-else="">
                                    <i class="fa fa-user"/> <field name="external_donor_name"/>
                                </t>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <i class="fa fa-book"/> <field name="book_count"/> libros
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="campus_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== CALENDAR VIEW ==================== -->
    <record id="view_crai_donation_calendar" model="ir.ui.view">
        <field name="name">crai.donation.calendar</field>
        <field name="model">crai.donation</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Donaciones" 
                      date_start="submission_date" 
                      color="state"
                      mode="month"
                      quick_create="0">
                <field name="name"/>
                <field name="donation_type"/>
                <field name="campus_id"/>
            </calendar>
        </field>
    </record>

    <!-- ==================== PIVOT VIEW ==================== -->
    <record id="view_crai_donation_pivot" model="ir.ui.view">
        <field name="name">crai.donation.pivot</field>
        <field name="model">crai.donation</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Donaciones">
                <field name="campus_id" type="row"/>
                <field name="donation_type" type="col"/>
                <field name="book_count" type="measure"/>
                <field name="total_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ==================== GRAPH VIEW ==================== -->
    <record id="view_crai_donation_graph" model="ir.ui.view">
        <field name="name">crai.donation.graph</field>
        <field name="model">crai.donation</field>
        <field name="arch" type="xml">
            <graph string="Gráfico de Donaciones" type="bar">
                <field name="state" type="row"/>
                <field name="donation_type" type="col"/>
            </graph>
        </field>
    </record>

    <!-- ==================== WIZARD REJECT VIEW ==================== -->
    <record id="view_crai_donation_reject_wizard_form" model="ir.ui.view">
        <field name="name">crai.donation.reject.wizard.form</field>
        <field name="model">crai.donation.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Donación">
                <group>
                    <field name="donation_id" readonly="1"/>
                    <field name="rejection_reason" 
                           placeholder="Explique claramente el motivo del rechazo..."
                           required="1"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" 
                            type="object" 
                            string="Confirmar Rechazo" 
                            class="btn-primary"/>
                    <button string="Cancelar" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
