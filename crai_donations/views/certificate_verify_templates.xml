<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="certificate_verification_page" name="Verificación de Certificado CRAI">
        <t t-call="web.frontend_layout">
            
            <div class="wrap py-5" style="background-color: #f4f6f9; min-height: 80vh;">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-md-9 col-lg-8">
                            
                            <div class="card shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
                                <div class="card-header text-white text-center border-0" style="background-color: #2c3e50; padding: 25px;">
                                    <h3 class="mb-0">Verificación de Certificado de Donación</h3>
                                </div>
                                
                                <div class="card-body p-5">
                                    <p class="text-center text-muted mb-4" style="font-size: 1.1em;">Ingrese el código alfanumérico que se encuentra en la parte inferior de su certificado oficial.</p>

                                    <form action="/crai/verificar" method="get" class="mb-5">
                                        <input type="hidden" name="db" t-att-value="request.db"/>
                                        <div class="input-group input-group-lg shadow-sm">
                                            <input type="text" name="code" class="form-control text-center" placeholder="Ej: B64A-1012-1E29-FFB6" t-att-value="search_code" required="required" style="font-family: monospace; letter-spacing: 1px;"/>
                                            <button type="submit" class="btn text-white px-4" style="background-color: #c9d51b;">
                                                <strong>Verificar</strong>
                                            </button>
                                        </div>
                                    </form>

                                    <t t-if="searched">
                                        
                                        <t t-if="certificate">
                                            <div class="alert alert-success mt-4 mb-0 shadow-sm" style="border-left: 6px solid #28a745; background-color: #f8fff9;">
                                                <h5 class="alert-heading text-success mb-3">
                                                    <i class="fa fa-check-circle mr-2"></i><strong>¡Certificado Auténtico!</strong>
                                                </h5>
                                                <div class="row mt-3" style="color: #2c3e50;">
                                                    <div class="col-md-6">
                                                        <p class="mb-2"><strong>Nº:</strong> <t t-esc="certificate.certificate_number"/></p>
                                                        <p class="mb-2"><strong>Fecha:</strong> <span t-field="certificate.certificate_issued_date" t-options="{'widget': 'date'}"/></p>
                                                        <p class="mb-0"><strong>Campus:</strong> <t t-esc="certificate.campus_id.name"/></p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <p class="mb-1"><strong>A nombre de:</strong><br/>
                                                            <span class="text-uppercase" style="font-size: 0.9em;">
                                                                <t t-if="certificate.donation_type == 'individual'">
                                                                    <t t-esc="certificate.student_id.name"/>
                                                                </t>
                                                                <t t-elif="certificate.donation_type == 'group'">
                                                                    <ul class="list-unstyled mb-0">
                                                                        <li><i class="fa fa-star text-warning mr-1"></i> <t t-esc="certificate.student_id.name"/></li>
                                                                        <t t-foreach="certificate.group_student_ids" t-as="member">
                                                                            <li><i class="fa fa-user mr-1 text-muted"></i> <t t-esc="member.name"/></li>
                                                                        </t>
                                                                    </ul>
                                                                </t>
                                                                <t t-else="">
                                                                    <t t-esc="certificate.external_donor_name"/>
                                                                </t>
                                                            </span>
                                                        </p>
                                                        <p class="mb-0 mt-2"><strong>Total Libros:</strong> <span class="badge badge-info text-white" style="background-color: #17a2b8; font-size: 1em;"><t t-esc="certificate.book_count"/></span></p>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>

                                        <t t-if="error">
                                            <div class="alert alert-danger mt-4 mb-0 text-center shadow-sm" style="border-left: 6px solid #dc3545;">
                                                <h5 class="alert-heading text-danger"><i class="fa fa-times-circle mr-2"></i><strong>Código no encontrado</strong></h5>
                                                <p class="mb-0 mt-2 text-muted" style="font-size: 0.9em;">Verifique el código e intente nuevamente.</p>
                                            </div>
                                        </t>
                                        
                                    </t>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
            
        </t>
    </template>
</odoo>
