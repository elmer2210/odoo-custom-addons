<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_donation_certificate_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    
                    <div class="header">
                        <div class="row" style="padding-top: 20px; align-items: center;">
                            <div class="col-3">
                                <img t-if="o.env.company.logo" t-att-src="image_data_uri(o.env.company.logo)" style="max-height: 76px;" alt="Logo"/>
                            </div>
                            <div class="col-9" style="text-align: right; padding-top: 10px;">
                                <strong style="font-size: 16px; color: #333;">Certificado Nº: </strong>
                                <span style="font-size: 16px;" t-esc="o.certificate_number"/>
                            </div>
                        </div>
                    </div>

                    <div class="page" style="font-family: Arial, sans-serif; font-size: 14px; padding: 10px 40px;">
                        
                        <div style="text-align: center; margin-bottom: 40px; margin-top: 20px;">
                            <h2 style="font-weight: bold; margin: 0;">CERTIFICADO DE DONACIÓN DE LIBROS</h2>
                            <h3 style="margin: 5px 0 0 0; font-size: 16px; font-weight: normal;">Centro de Recursos para el Aprendizaje e Investigación (CRAI)</h3>
                        </div>

                        <div style="text-align: justify; margin-bottom: 20px; line-height: 1.5;">
                            Por medio del presente documento, la Universidad a través del Centro de Recursos para el Aprendizaje y la Investigación (CRAI) de la sede <strong style="text-transform: uppercase;"><t t-esc="o.campus_id.name"/></strong>, otorga el presente reconocimiento a 
                            <t t-if="o.donation_type == 'individual'">el estudiante</t>
                            <t t-if="o.donation_type == 'group'">los estudiantes</t>
                            <t t-if="o.donation_type == 'external'">el/la donante</t>
                            <t t-if="o.donation_type in ('individual', 'group')">
                                de la carrera <strong style="text-transform: uppercase;"><t t-esc="o.student_career_id.name"/></strong>:
                            </t>
                            <t t-else="">
                                :
                            </t>
                        </div>

                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 30px; font-size: 13px;">
                            <thead>
                                <tr style="border: 1px solid black; background-color: #f2f2f2;">
                                    <th style="border: 1px solid black; padding: 8px; text-align: center; width: 10%;">#</th>
                                    <th style="border: 1px solid black; padding: 8px; text-align: left; width: 60%;">Nombres Completos</th>
                                    <th style="border: 1px solid black; padding: 8px; text-align: left; width: 30%;">N° de Cédula</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="o.donation_type == 'individual'">
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px; text-align: center;">1</td>
                                        <td style="border: 1px solid black; padding: 8px; text-transform: uppercase;"><t t-esc="o.student_id.name"/></td>
                                        <td style="border: 1px solid black; padding: 8px;"><t t-esc="o.student_id.number_id"/></td>
                                    </tr>
                                </t>
                                
                                <t t-if="o.donation_type == 'group'">
                                    <t t-set="index" t-value="1"/>
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px; text-align: center;"><t t-esc="index"/></td>
                                        <td style="border: 1px solid black; padding: 8px; text-transform: uppercase;"><t t-esc="o.student_id.name"/></td>
                                        <td style="border: 1px solid black; padding: 8px;"><t t-esc="o.student_id.number_id"/></td>
                                    </tr>
                                    <t t-foreach="o.group_student_ids" t-as="student">
                                        <t t-set="index" t-value="index + 1"/>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 8px; text-align: center;"><t t-esc="index"/></td>
                                            <td style="border: 1px solid black; padding: 8px; text-transform: uppercase;"><t t-esc="student.name"/></td>
                                            <td style="border: 1px solid black; padding: 8px;"><t t-esc="student.number_id"/></td>
                                        </tr>
                                    </t>
                                </t>

                                <t t-if="o.donation_type == 'external'">
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px; text-align: center;">1</td>
                                        <td style="border: 1px solid black; padding: 8px; text-transform: uppercase;"><t t-esc="o.external_donor_name"/></td>
                                        <td style="border: 1px solid black; padding: 8px;">N/A</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div style="text-align: justify; margin-bottom: 20px; line-height: 1.5;">
                            Por su invaluable y desinteresada contribución al enriquecimiento del acervo bibliográfico institucional, mediante la donación del siguiente material:
                        </div>

                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 40px; font-size: 13px;">
                            <thead>
                                <tr style="border: 1px solid black; background-color: #f2f2f2;">
                                    <th style="border: 1px solid black; padding: 8px; text-align: left; width: 45%;">Título de obra</th>
                                    <th style="border: 1px solid black; padding: 8px; text-align: left; width: 30%;">Autor</th>
                                    <th style="border: 1px solid black; padding: 8px; text-align: left; width: 15%;">ISBN</th>
                                    <th style="border: 1px solid black; padding: 8px; text-align: right; width: 10%;">Precio</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.book_ids" t-as="book">
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px;"><t t-esc="book.title"/></td>
                                        <td style="border: 1px solid black; padding: 8px;"><t t-esc="book.author"/></td>
                                        <td style="border: 1px solid black; padding: 8px;"><t t-esc="book.isbn or '-'"/></td>
                                        <td style="border: 1px solid black; padding: 8px; text-align: right;">$<t t-esc="'%.2f' % book.cost"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div style="text-align: justify; line-height: 1.5; margin-bottom: 40px;">
                            Certificado emitido en la ciudad de Guayaquil, a los <t t-esc="o.certificate_issued_date.day"/> días del mes de <span t-field="o.certificate_issued_date" t-options="{'widget': 'date', 'format': 'MMMM'}"/> del año <t t-esc="o.certificate_issued_date.year"/>.
                        </div>
                    </div>

                    <div class="footer">
                        <div class="row" style="border-top: 1px solid #dee2e6; padding-top: 15px; page-break-inside: avoid;">
        
                            <div class="col-9 text-left">
                                  <p style="font-size: 11px; color: #555; margin-bottom: 5px;">
                                        Puede verificar la autenticidad de este documento escaneando el código QR o ingresando al siguiente enlace:
                                  </p>
                                 <a t-attf-href="https://monitoreocrai.umet.edu.ec/web/crai/verificar?db={{ request.env.cr.dbname }}&amp;code={{ o.certificate_code }}" style="font-size: 11px; color: #2c3e50; text-decoration: none;">
                                      <strong>https://monitoreocrai.umet.edu.ec/web/crai/verificar?db=<t t-esc="request.env.cr.dbname"/>&amp;code=<t t-esc="o.certificate_code"/></strong>
                                 </a>
                           </div>
        
                          <div class="col-3 text-right">
                                <img t-attf-src="/report/barcode/?barcode_type=QR&amp;value=https://monitoreocrai.umet.edu.ec/web/crai/verificar%3Fdb%3D{{ request.env.cr.dbname }}%26code%3D{{ o.certificate_code }}&amp;width=80&amp;height=80" style="width: 80px; height: 80px; float: right;"/>
                          </div>

                      </div>
                    </div>

                </t>
            </t>
        </t>
    </template>
</odoo>
