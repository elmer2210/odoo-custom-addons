<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- TODAS las plantillas van dentro de un solo bloque <data> -->
        
        <record id="email_template_certificate_issued" model="mail.template">
            <field name="name">CRAI: Certificado de Donación</field>
            <field name="model_id" ref="model_crai_donation"/>
            <field name="subject">Su Certificado de Donación - {{object.certificate_number}}</field>
            <field name="email_from">notificaciones.crai@umet.edu.ec</field>
            <field name="email_to">{{object.student_id.email if object.donation_type in ['individual', 'group'] else object.external_donor_email}}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
                    <div style="background-color: #c9d51b; color: #333; padding: 20px; text-align: center;">
                        <h2>¡Su Certificado de Donación está Listo!</h2>
                    </div>
                    
                    <div style="padding: 20px; background-color: #f9f9f9;">
                        <p>
                            <t t-if="object.donation_type in ['individual', 'group']">
                                Estimado/a <strong><t t-out="object.student_id.name or ''">Estudiante</t></strong>,
                            </t>
                            <t t-else="">
                                Estimado/a <strong><t t-out="object.external_donor_name or ''">Donante</t></strong>,
                            </t>
                        </p>
                        
                        <p>Nos complace hacerle llegar su <strong>Certificado Oficial de Donación</strong>.</p>
                        
                        <table style="width: 100%; margin: 20px 0; border-collapse: collapse;">
                            <tr style="background-color: #e8e8e8;">
                                <td style="padding: 10px; border: 1px solid #ddd;"><strong>Número de Certificado:</strong></td>
                                <td style="padding: 10px; border: 1px solid #ddd;">
                                    <span style="font-size: 16px; font-weight: bold; color: #c9d51b;">
                                        <t t-out="object.certificate_number or ''">CERT-001</t>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; border: 1px solid #ddd;"><strong>Código de Verificación:</strong></td>
                                <td style="padding: 10px; border: 1px solid #ddd;">
                                    <code style="background-color: #f4f4f4; padding: 5px; font-family: monospace;">
                                        <t t-out="object.certificate_code or ''">XXXX-XXXX-XXXX-XXXX</t>
                                    </code>
                                </td>
                            </tr>
                            <tr style="background-color: #e8e8e8;">
                                <td style="padding: 10px; border: 1px solid #ddd;"><strong>Fecha de Emisión:</strong></td>
                                <td style="padding: 10px; border: 1px solid #ddd;">
                                    <t t-out="object.certificate_issued_date or ''">01/01/2025</t>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; border: 1px solid #ddd;"><strong>Libros Donados:</strong></td>
                                <td style="padding: 10px; border: 1px solid #ddd;">
                                    <t t-out="object.book_count or 0">0</t>
                                </td>
                            </tr>
                            <tr style="background-color: #e8e8e8;">
                                <td style="padding: 10px; border: 1px solid #ddd;"><strong>Costo Total:</strong></td>
                                <td style="padding: 10px; border: 1px solid #ddd;">
                                    $ <t t-out="'%.2f' % (object.total_cost or 0.0)">0.00</t>
                                </td>
                            </tr>
                        </table>
                        
                        <div style="background-color: #d1ecf1; border-left: 4px solid #0c5460; padding: 15px; margin: 20px 0;">
                            <p style="margin: 0;"><strong>Importante:</strong></p>
                            <ul style="margin: 10px 0 0 20px;">
                                <li>Este certificado incluye un código de verificación único.</li>
                                <li>El certificado adjunto está en formato PDF.</li>
                                <li>Puede verificar la autenticidad del certificado usando el código de verificación.</li>
                            </ul>
                        </div>
                        
                        <p style="margin-top: 30px;">
                            <strong>Agradecemos profundamente su generosa contribución a nuestra biblioteca.</strong>
                        </p>
                        
                        <p>Su donación ayudará a enriquecer los recursos educativos de nuestra institución.</p>
                        
                        <p style="margin-top: 30px; font-size: 12px; color: #666;">
                            Este es un correo automático. Por favor no responder directamente a este mensaje.
                        </p>
                    </div>
                    
                    <div style="background-color: #7d858c; color: white; padding: 10px; text-align: center; font-size: 12px;">
                        <p>Sistema CRAI - Universidad Nacional de Chimborazo</p>
                    </div>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
        
        
    </data>
</odoo>