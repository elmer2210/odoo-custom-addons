<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_crai_computer" model="ir.actions.act_window">
        <field name="name">Equipos</field>
        <field name="res_model">crai.computer</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'search_default_my_campuses': 1,
            'search_default_group_by_campus': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registra el primer equipo del laboratorio.
            </p>
        </field>
    </record>

    <record id="action_crai_computer_session" model="ir.actions.act_window">
        <field name="name">Sesiones</field>
        <field name="res_model">crai.computer.session</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="context">{
            'search_default_my_campuses': 1,
            'search_default_group_by_campus': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay sesiones registradas en tus campus.
            </p>
        </field>
    </record>


    <menuitem id="menu_crai_computers_root" name="Computadoras" sequence="30"/>

    <menuitem id="menu_crai_computers" name="Equipos"
            parent="menu_crai_computers_root" action="action_crai_computer"/>

    <menuitem id="menu_crai_computer_sessions" name="Sesiones"
            parent="menu_crai_computers_root" action="action_crai_computer_session"/>

</odoo>
