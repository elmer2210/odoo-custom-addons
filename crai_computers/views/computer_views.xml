<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_crai_computer_tree" model="ir.ui.view">
    <field name="name">crai.computer.tree</field>
    <field name="model">crai.computer</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="code"/>
        <field name="site_id"/>
        <field name="campus_id"/>
        <field name="is_active"/>
        <field name="active_session_count"/>
      </tree>
    </field>
  </record>

  <record id="view_crai_computer_form" model="ir.ui.view">
    <field name="name">crai.computer.form</field>
    <field name="model">crai.computer</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="site_id"/>
            <field name="campus_id"/>
            <field name="is_active"/>
          </group>
          <group string="Sesión actual">
            <field name="current_session_id" readonly="1"/>
            <field name="active_session_count" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_crai_computer_search" model="ir.ui.view">
    <field name="name">crai.computer.search</field>
    <field name="model">crai.computer</field>
    <field name="arch" type="xml">
      <search string="Buscar Equipos">
        <field name="name"/>
        <field name="code"/>
        <field name="campus_id"/>

        <filter name="my_campuses" string="Mis Campus" domain="[('campus_id.user_ids', '=', uid)]"/>

        <group expand="0" string="Agrupar por">
          <filter name="group_by_campus" string="Campus" context="{'group_by': 'campus_id'}"/>
          <filter name="group_by_active" string="Estado Activo" context="{'group_by': 'is_active'}"/>
        </group>
      </search>
    </field>
  </record>

</odoo>
