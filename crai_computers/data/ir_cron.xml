<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="cron_close_idle_sessions" model="ir.cron">
    <field name="name">CRAI: Cerrar sesiones inactivas</field>
    <field name="model_id" ref="base.model_ir_cron"/> <!-- placeholder, se invoca por método en session model -->
    <field name="state">code</field>
    <field name="code">env['crai.computer.session']._cron_close_idle_sessions()</field>
    <field name="interval_number">5</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
  </record>
</odoo>
